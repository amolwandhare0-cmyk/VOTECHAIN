# ================================================================
# VoteChain — GH Raisoni University (GHRCEM)
# Copy this file to .env and fill in your values
# ================================================================

# ── OPTION 1: Brevo SMTP (Recommended — Free, no App Password) ─
# Sign up at https://app.brevo.com → SMTP & API → SMTP tab
BREVO_USER=
BREVO_PASS=

# ── OPTION 2: Gmail App Password ───────────────────────────────
# Go to https://myaccount.google.com/apppasswords
# Enable 2-Step Verification first, then generate App Password
GMAIL_USER=
GMAIL_PASS=

# ── OPTION 3: Outlook / Hotmail ────────────────────────────────
OUTLOOK_USER=
OUTLOOK_PASS=

# ── Server ─────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change_this_to_a_random_string
